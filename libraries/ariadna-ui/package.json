{
  "name": "@iwyfaf-vue-ui/ariadna-ui",
  "description": "Vue 3 UI library.",
  "version": "1.3.2-beta.12",
  "license": "proprietary",
  "author": {
    "name": "iWatchYouFromAfar",
    "email": "tommy.riley@yandex.ru"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:iwyfaf-vue-ui/ariadna-ui.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "update-package": "node packageGenerator/update-package.js",
    "build": "npm run update-package && vue-tsc --noEmit && vite build --out-dir dist",
    "build-dev": "npm run update-package && vue-tsc --noEmit && vite build --out-dir dist --mode development",
    "test": "vitest --dom --watch=false",
    "test:watch": "vitest --dom",
    "release": "npm run build && changelogen --release --push --publish --no-github",
    "release-notes": "changelogen gh release",
    "pre-release": "npm run build && changelogen --release --no-github --no-tag --prerelease beta --push --publish --publishTag beta"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "changelogen": "^0.6.1",
    "happy-dom": "^17.4.4",
    "prettier": "^3.5.3",
    "rollup": "^4.35.0",
    "rollup-plugin-clear": "^2.0.7",
    "sass": "^1.85.1",
    "stylelint": "^16.15.0",
    "stylelint-config-css-modules": "^4.4.0",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.3.2",
    "vite": "^6.2.1",
    "vite-plugin-static-copy": "^2.3.0",
    "vitest": "^3.1.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  },
  "exports": {
    "./Button": {
      "module": "./dist/lib/components/buttons/Button/Button.esm.js",
      "types": "./dist/lib/components/buttons/Button/Button.d.ts"
    },
    "./ThemeBuilder": {
      "module": "./dist/lib/utilities/facades/ThemeBuilder/ThemeBuilder.esm.js",
      "types": "./dist/lib/utilities/facades/ThemeBuilder/ThemeBuilder.d.ts"
    },
    "./Capitalize": {
      "module": "./dist/lib/utilities/helpers/Capitalize/Capitalize.esm.js",
      "types": "./dist/lib/utilities/helpers/Capitalize/Capitalize.d.ts"
    },
    "./ToKebab": {
      "module": "./dist/lib/utilities/helpers/ToKebab/ToKebab.esm.js",
      "types": "./dist/lib/utilities/helpers/ToKebab/ToKebab.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "Button": [
        "./dist/lib/components/buttons/Button/Button.d.ts"
      ],
      "ThemeBuilder": [
        "./dist/lib/utilities/facades/ThemeBuilder/ThemeBuilder.d.ts"
      ],
      "Capitalize": [
        "./dist/lib/utilities/helpers/Capitalize/Capitalize.d.ts"
      ],
      "ToKebab": [
        "./dist/lib/utilities/helpers/ToKebab/ToKebab.d.ts"
      ]
    }
  }
}