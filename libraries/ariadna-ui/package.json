    "release": "npm run build && changelogen --release --push --publish --no-github",
    "release-notes": "changelogen gh release",
    "pre-release": "npm run test && npm run build && changelogen --release --no-github --no-commit --no-output --no-tag --prerelease beta --push --publish --publishTag beta"
  },
